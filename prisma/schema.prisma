// ---------- GENERATOR & DATASOURCE ----------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------
enum Status {
  active
  inactive
}

enum ProjectStatus {
  todo
  in_progress
  completed
  on_hold
}

// ---------- MODELS ----------
model Organization {
  organization_id Int       @id @default(autoincrement())
  name            String
  status          Status
  created_by      String
  created_at      DateTime  @default(now())

  createdBy       Users     @relation("OrganizationCreatedBy", fields: [created_by], references: [user_id])

  users           Users[]
  projects        Project[]
  developerRoles  DeveloperRole[]
}

model Users {
  user_id         String   @id @default(uuid())
  name            String
  email           String   @unique
  password        String
  status          Status   @default(active)
  organization_id Int
  created_by      String?
  created_at      DateTime @default(now())
  userRole_id     Int

  // Relations
  organization    Organization @relation(fields: [organization_id], references: [organization_id])
  userRole        UserRole     @relation(fields: [userRole_id], references: [userRole_id])

  createdBy       Users?       @relation("UserCreatedBy", fields: [created_by], references: [user_id])
  createdUsers    Users[]      @relation("UserCreatedBy")

  projectsCreated Project[]    @relation("ProjectCreatedBy")
  projectsUpdated Project[]    @relation("ProjectUpdatedBy")
  organizations   Organization[] @relation("OrganizationCreatedBy")

  developerRolesCreated DeveloperRole[] @relation("RoleCreatedBy")
  projectAssignments    ProjectUserRole[]
  budgets               Budget[]
}

model UserRole {
  userRole_id Int      @id @default(autoincrement())
  roleName    String   // Company Admin, Finance, Viewer, Developer
  created_at  DateTime @default(now())

  users       Users[]
  projectRoles ProjectUserRole[]
  permissions Permission[]
}

model Project {
  project_id      Int      @id @default(autoincrement())
  name            String
  description     String
  organization_id Int
  start_date      DateTime
  end_date        DateTime
  status          ProjectStatus
  total_amount    Decimal
  created_by      String
  created_at      DateTime @default(now())
  updated_by      String
  updated_at      DateTime?

  // Relations
  organization    Organization @relation(fields: [organization_id], references: [organization_id])
  createdBy       Users        @relation("ProjectCreatedBy", fields: [created_by], references: [user_id])
  updatedBy       Users        @relation("ProjectUpdatedBy", fields: [updated_by], references: [user_id])

  projectAssignments ProjectUserRole[]
  budgets            Budget[]
}

model DeveloperRole {
  developerRole_id Int      @id @default(autoincrement())
  role_name        String   // Project Manager, Frontend, Backend, AI/ML, Blockchain
  organization_id  Int
  created_by       String
  created_at       DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organization_id], references: [organization_id])
  createdBy    Users        @relation("RoleCreatedBy", fields: [created_by], references: [user_id])

  projectRoles ProjectUserRole[]
  permissions  Permission[]
}

model ProjectUserRole {
  id              Int @id @default(autoincrement())
  project_id      Int
  user_id         String
  userRole_id     Int?
  developerRole_id Int?
  assigned_at     DateTime @default(now())

  // Relations
  project   Project       @relation(fields: [project_id], references: [project_id])
  user      Users         @relation(fields: [user_id], references: [user_id])
  userRole  UserRole?     @relation(fields: [userRole_id], references: [userRole_id])
  devRole   DeveloperRole? @relation(fields: [developerRole_id], references: [developerRole_id])
}

model Budget {
  budget_id  Int      @id @default(autoincrement())
  project_id Int
  updated_by String
  allocated  Decimal
  spent      Decimal
  remaining  Decimal
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  project   Project @relation(fields: [project_id], references: [project_id])
  updatedBy Users   @relation(fields: [updated_by], references: [user_id])
}

model Permission {
  permission_id   Int      @id @default(autoincrement())
  permission_name String
  allowed         Boolean
  userRole_id     Int?
  developerRole_id Int?

  // Relations
  userRole UserRole?     @relation(fields: [userRole_id], references: [userRole_id])
  devRole  DeveloperRole? @relation(fields: [developerRole_id], references: [developerRole_id])
}
