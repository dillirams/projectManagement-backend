// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Organization{
  organization_id Int @id @default(autoincrement())
  name String
  createdby String
  createdAT DateTime
  createdBy       Users     @relation("OrganizationCreatedBy", fields: [createdby], references: [user_id])

  user Users[]
  project Project[]
   roles    Role[]
}

enum Status{
  active
  inactive
}
model Users{
  user_id String @id @default(uuid())
  name String
  email String
  password String
  status Status
  organization_id Int
  organization Organization @relation(fields: [organization_id], references: [organization_id])
  created_by String?
  created_at DateTime

  createdBy     Users?       @relation("UserCreatedBy", fields: [created_by], references: [user_id])
  createdUsers  Users[]      @relation("UserCreatedBy")
  projectsCreated Project[] @relation("ProjectCreatedBy")
  projectsUpdated Project[] @relation("ProjectUpdatedBy")
  organizations Organization[] @relation("OrganizationCreatedBy")
  rolesCreated    Role[]    @relation("RoleCreatedBy")
  userProjectRole ProjectUserRole[]

  budget Budget[]

}

enum ProjectStatus{
  todo

}

 model Project{
  project_id      Int      @id @default(autoincrement())
  name            String
  description     String
  organization_id Int
  start_date      DateTime
  end_date        DateTime
  status          ProjectStatus
  total_amount    Decimal
  created_by      String
  created_at      DateTime @default(now())
  updated_by      String
  updated_at      DateTime?

  
  organization Organization @relation(fields: [organization_id], references: [organization_id])
  createdBy    Users         @relation("ProjectCreatedBy", fields: [created_by], references: [user_id])
  updatedBy    Users        @relation("ProjectUpdatedBy", fields: [updated_by], references: [user_id])

  projectUserRole ProjectUserRole[]

  budget Budget[]
 }


model Role {
  role_id         Int      @id @default(autoincrement())
  role_name       String
  organization_id Int
  created_by      String
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [organization_id])
  createdBy     Users        @relation("RoleCreatedBy", fields: [created_by], references: [user_id])

  projectUserRole ProjectUserRole[]

  permission Permission[]
}


model ProjectUserRole {
  id         Int      @id @default(autoincrement())
  project_id Int
  user_id    String
  role_id    Int
  assigned_at DateTime @default(now())

  user Users @relation(fields: [user_id], references: [user_id])
  project Project @relation(fields: [project_id], references: [project_id])
 role    Role    @relation(fields: [role_id], references: [role_id])

}

model Budget {
  budget_id  Int      @id @default(autoincrement())
  project_id Int
  updated_by String
  allocated  Decimal
  spent      Decimal
  remaining  Decimal
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project   Project @relation(fields: [project_id], references: [project_id])
  updatedBy Users    @relation(fields: [updated_by], references: [user_id])
}

model Permission {
  permission_id  Int      @id @default(autoincrement())
  role_id        Int
  permission_name String
  allowed        Boolean

  role Role @relation(fields: [role_id], references: [role_id])
}